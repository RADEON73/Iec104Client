{
  "version": 3,

  "configurePresets": [

    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "environment": {
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "windows-win7-base",
      "hidden": true,
      "generator": "Visual Studio 16 2019",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "v142"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0"
      }
    },

    {
      "name": "windows-clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_LINKER": "lld-link.exe"
      }
    },

    {
      "name": "windows-msvc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_LINKER": "link.exe",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded"
      }
    },

    {
      "name": "windows-static",
      "hidden": true,
      "cacheVariables": {
        "USE_STATIC_RUNTIME": "ON"
      }
    },

    {
      "name": "windows-dynamic",
      "hidden": true,
      "cacheVariables": {
        "USE_STATIC_RUNTIME": "OFF"
      }
    },

    {
      "name": "windows-win7-static",
      "hidden": true,
      "inherits": "windows-win7-base",
      "cacheVariables": {
        "USE_STATIC_RUNTIME": "ON"
      }
    },

    {
      "name": "windows-win7-dynamic",
      "hidden": true,
      "inherits": "windows-win7-base",
      "cacheVariables": {
        "USE_STATIC_RUNTIME": "OFF"
      }
    },

    {
      "name": "windows-static-clang-debug",
      "displayName": "Windows Static Debug (/MT) - Clang",
      "inherits": [
        "windows-base",
        "windows-static",
        "windows-clang"
      ],
      "binaryDir": "${sourceDir}/build/clang/static_debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "windows-static-clang-release",
      "displayName": "Windows Static Release (/MT) - Clang",
      "inherits": [
        "windows-base",
        "windows-static",
        "windows-clang"
      ],
      "binaryDir": "${sourceDir}/build/clang/static_release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "windows-static-clang-relwithdebinfo",
      "displayName": "Windows Static RelWithDebInfo (/MT) - Clang",
      "inherits": [
        "windows-base",
        "windows-static",
        "windows-clang"
      ],
      "binaryDir": "${sourceDir}/build/clang/static_relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },

    {
      "name": "windows-dynamic-clang-debug",
      "displayName": "Windows Dynamic Debug (/MD) - Clang",

      "inherits": [
        "windows-base",
        "windows-dynamic",
        "windows-clang"
      ],
      "binaryDir": "${sourceDir}/build/clang/dynamic_relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
